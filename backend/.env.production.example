# Copy values into Vercel environment settings, not a committed private .env.
# Requires a reachable SQL Server/Azure SQL instance with existing data migrated.
APP_ENV=production
DB_ENGINE=mssql
MSSQL_SERVER=tcp:YOUR-SERVER.database.windows.net,1433
MSSQL_DATABASE=kongu_db
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_TRUSTED_CONNECTION=no
MSSQL_TRUST_CERTIFICATE=no
MSSQL_ENCRYPT=yes
SECRET_KEY=
FACULTY_REGISTRATION_CODE=
SEED_DATABASE_ON_STARTUP=false

# Connect a PRIVATE Blob store in Vercel Storage; never expose its token in VITE_.
UPLOAD_STORAGE=vercel_blob
# Vercel injects BLOB_STORE_ID/OIDC or BLOB_READ_WRITE_TOKEN when connected.
# BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_SIZE_MB=4
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Preserve your existing institutional attendance values when configuring these.
MIN_WORK_HOURS_FOR_PRESENT=3.0
MIN_WORK_HOURS_FOR_HALF_DAY=1.5
DEFAULT_GEOFENCE_RADIUS_M=2000
MIN_ACCURACY_M=150
IMPOSSIBLE_TRAVEL_KMH=120
