FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# pyodbc needs unixODBC plus Microsoft's SQL Server ODBC driver. Install
# Microsoft's Debian repository package rather than editing its source list:
# it creates the matching keyring and a single signed-by declaration.
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl libgssapi-krb5-2 unixodbc unixodbc-dev \
    && curl -fsSLo /tmp/packages-microsoft-prod.deb \
        https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install --no-install-recommends -y msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY . ./

# Vercel supplies PORT at runtime. Defaulting to 80 also permits local docker
# execution with `docker run -p 8000:80`.
CMD ["sh", "-c", "uvicorn entrypoint:app --host 0.0.0.0 --port ${PORT:-80}"]
