# ── Database ────────────────────────────────────────────────────────────────
# Engine: 'mssql' (production) or 'sqlite' (development, default)
DB_ENGINE=sqlite

# MSSQL settings (used when DB_ENGINE=mssql)
MSSQL_SERVER=localhost\MSSQL
MSSQL_DATABASE=kongu_db
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUSTED_CONNECTION=yes
MSSQL_TRUST_CERTIFICATE=yes
MSSQL_USER=
MSSQL_PASSWORD=

# Optional explicit override (leave commented to use settings above)
# DATABASE_URL=mssql+pyodbc://user:pass@localhost:1433/kongu_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Security ────────────────────────────────────────────────────────────────
# REQUIRED. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_ENV=development
# Required only when creating NEW faculty accounts. Share privately with verified staff.
# Blank disables public faculty registration; existing faculty can still log in.
FACULTY_REGISTRATION_CODE=

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated explicit origins — never use "*"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=8
RATE_LIMIT_ATTENDANCE_PER_MINUTE=20

# ── Uploads ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20

# ── Geofence defaults (metres) ──────────────────────────────────────────────
DEFAULT_GEOFENCE_RADIUS_M=300
MIN_ACCURACY_M=100
IMPOSSIBLE_TRAVEL_KMH=120
